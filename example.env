PORT=8080
GLPI_URL=https://grupolipetral.verdanadesk.com
GLPI_APP_TOKEN=seu_app_token_aqui
GLPI_USER_TOKEN=seu_user_token_aqui
GLPI_TECH_GROUP=1
REFRESH_INTERVAL_SEC=30
LOG_MAX_SIZE_MB=50
LOG_MAX_AGE_DAYS=30
# URL opcional de arquivo de som .mp3 para novos chamados (baixa na inicialização)
NOTIFICATION_SOUND_URL=
# URL de arquivo de som .mp3 para chamados críticos / prioridade alta para cima (baixa na inicialização)
# Padrão: Airport Announcement Starting
CRITICAL_SOUND_URL=https://www.myinstants.com/media/sounds/airport-announcement-starting.mp3
# Regras de som por categoria no formato (Categoria, URL_MP3). Múltiplas regras separadas por vírgula ou ponto e vírgula
# Exemplo: CATEGORY_SOUNDS="(Equipamentos e Acessórios > Perda / Roubo, https://exemplo.com/alerta-roubo.mp3), (Protheus > Faturamento, https://exemplo.com/faturamento.mp3)"
CATEGORY_SOUNDS=
